# Banco. Local (padrão): file:./dados/central.db
# Supabase/Postgres: postgresql://usuario:senha@host:5432/postgres
DATABASE_URL="file:./dados/central.db"

# Segredo que cifra as chaves salvas no painel. O `npm run setup` gera um.
# Na Vercel, crie a variável APP_SECRET com 32+ caracteres aleatórios.
APP_SECRET=""

# Endereço público do sistema (links de volta das redes sociais e do Buffer).
APP_URL="http://localhost:3000"

# Rastro: acha o seu negócio no Google Maps. O `npm run setup` preenche.
RASTRO_URL="http://127.0.0.1:4310"
RASTRO_TOKEN=""

# Renovação diária dos tokens das redes (Instagram vale 60 dias).
# Chame GET /api/cron/renovar-tokens-redes uma vez por dia com
# "Authorization: Bearer <CRON_SECRET>" (crontab da VPS ou Vercel Cron).
CRON_SECRET=""
